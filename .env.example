# Copy to .env and fill in. .env is git-ignored. Agents never read passwords from chat.
# Edit it in VS Code (UTF-8). Put a value in double quotes if it contains # (or spaces or quotes):
# unquoted, everything from # on is dropped as a comment, e.g. ROLE_CLERK_PASS="pa#ss" , not ROLE_CLERK_PASS=pa#ss

# Test environment only
APP_BASE_URL=https://test.example.gr


# Roles: comma-separated. Each needs ROLE_<NAME>_USER / ROLE_<NAME>_PASS (name upper-cased, non-alphanumerics → _)
ROLES=admin,clerk
ROLE_ADMIN_USER=
ROLE_ADMIN_PASS=
ROLE_CLERK_USER=
ROLE_CLERK_PASS=

# Role used by tests/seed.spec.ts (defaults to the first role)
SEED_ROLE=

# Login form. Defaults handle common Greek/English labels; the bootstrap prompt adjusts these if needed.
LOGIN_PATH=/
# LOGIN_USER_LABEL=χρήστη|username
# LOGIN_PASS_LABEL=κωδικ|password
# LOGIN_SUBMIT_LABEL=σύνδεση|είσοδος
# LOGIN_URL_PATTERN=login|signin|auth

# If the app uses a test-id attribute other than data-testid (keep in sync with .vscode/playwright-mcp.json).
# /bootstrap checks whether Appian test labels reach the DOM (platform rule P17).
# TEST_ID_ATTRIBUTE=data-testid

# Date input format accepted for the test users' Appian locale (platform rule P6a; /bootstrap confirms it).
# Tokens: dd d MM M yyyy yy
APPIAN_DATE_FORMAT=dd/MM/yyyy
